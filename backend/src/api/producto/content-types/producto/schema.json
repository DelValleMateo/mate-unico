{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Producto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nombreProducto": {
      "type": "string"
    },
    "descripcion": {
      "type": "text"
    },
    "precio": {
      "type": "decimal"
    },
    "tp_producto": {
      "type": "enumeration",
      "enum": [
        "COMBO1",
        "COMBO2",
        "M_CALABAZA",
        "M_MADERA",
        "M_METAL",
        "M_VIDRIO",
        "GRABADO"
      ]
    },
    "tiene_Grabado": {
      "type": "boolean"
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
